{% comment %}
Emergenetics Landing Section
- Hero with background image + CTAs
- Offerings (3 cards)
- How it works (1-2-3)
- Testimonials (3)
- FAQ (details/summary, no JS)
- Contact (native Shopify contact form)
- Mobile sticky CTA
Notes:
- No React/TSX/shadcn/Tailwind; just scoped CSS.
- All content is editable via the section settings.
{% endcomment %}

<section id="emergenetics-landing-{{ section.id }}" class="emg-wrap">
  {%- assign hero_img = section.settings.hero_image -%}
  <div class="emg-hero" {% if hero_img != blank %}style="background-image:linear-gradient(rgba(20,15,10,.7), rgba(20,15,10,.8)), url('{{ hero_img | image_url: width: 2400 }}');"{% endif %} aria-label="Emergenetics hero">
    <div class="emg-container emg-center">
      <h1 class="emg-hero-title">
        {{ section.settings.hero_title | default: "Unlock the Science of You" }}
      </h1>
      <p class="emg-hero-subtitle">
        {{ section.settings.hero_subtitle | default: "Discover how you think, behave, and collaborate with Emergenetics®" }}
      </p>
      <div class="emg-cta-row">
        {% if section.settings.buy_url_1 != blank %}
          <a class="emg-btn emg-btn-primary" href="{{ section.settings.buy_url_1 }}" aria-label="Start your Emergenetics assessment">
            {{ section.settings.cta_primary_text | default: "Start Your Assessment" }}
          </a>
        {% endif %}
        <a class="emg-btn emg-btn-outline" href="#contact-{{ section.id }}" aria-label="Contact Jes Cruz">
          {{ section.settings.cta_secondary_text | default: "Talk to Jes" }}
        </a>
      </div>
    </div>
  </div>

  <!-- What is Emergenetics -->
  <div class="emg-section emg-card-bg" aria-labelledby="what-is-emergenetics-{{ section.id }}">
    <div class="emg-container emg-center">
      <h2 id="what-is-emergenetics-{{ section.id }}" class="emg-h2">What is Emergenetics®?</h2>
      <div class="emg-two">
        <div class="emg-item">
          <div class="emg-icon">🧠</div>
          <h3 class="emg-h3">Thinking Preferences</h3>
          <p class="emg-muted">Analytical • Structural • Social • Conceptual</p>
        </div>
        <div class="emg-item">
          <div class="emg-icon">📈</div>
          <h3 class="emg-h3">Behavioral Attributes</h3>
          <p class="emg-muted">Expressiveness • Assertiveness • Flexibility</p>
        </div>
      </div>
      <p class="emg-body">
        Used by organizations worldwide to build smarter, kinder teams through science-backed insights into thinking and behavior patterns.
      </p>
      <p class="emg-footnote">Emergenetics® is a registered trademark of Emergenetics International.</p>
    </div>
  </div>

  <!-- Offerings -->
  <div class="emg-section emg-muted-bg" aria-labelledby="offerings-{{ section.id }}">
    <div class="emg-container">
      <h2 id="offerings-{{ section.id }}" class="emg-h2 emg-center">Choose Your Path</h2>
      <div class="emg-grid3">
        <!-- Card 1 -->
        <article class="emg-card">
          {% if section.settings.card1_image %}
            <img class="emg-card-img" src="{{ section.settings.card1_image | image_url: width: 900 }}" alt="Emergenetics Assessment and 1-on-1 Debrief" loading="lazy">
          {% endif %}
          <div class="emg-card-pad">
            <h3 class="emg-card-title">Assessment + 1:1 Debrief</h3>
            <p class="emg-card-desc">Great for individuals and leaders</p>
            <div class="emg-price">{{ section.settings.price_1 | default: "$XXX" }}</div>
            <ul class="emg-list">
              <li>Personal cognitive and behavioral profile</li>
              <li>60–75 minute live debrief session</li>
              <li>Practical application action plan</li>
            </ul>
            {% if section.settings.buy_url_1 != blank %}
              <a class="emg-btn emg-btn-primary emg-full" href="{{ section.settings.buy_url_1 }}" aria-label="Book your Emergenetics assessment">
                Book Your Assessment
              </a>
            {% endif %}
          </div>
        </article>

        <!-- Card 2 -->
        <article class="emg-card emg-card-highlight">
          {% if section.settings.card2_image %}
            <div class="emg-badge">POPULAR</div>
            <img class="emg-card-img" src="{{ section.settings.card2_image | image_url: width: 900 }}" alt="Assessment with eLearning and Debrief package" loading="lazy">
          {% endif %}
          <div class="emg-card-pad">
            <h3 class="emg-card-title">Assessment + eLearning + Debrief</h3>
            <p class="emg-card-desc">Learn, apply, and integrate</p>
            <div class="emg-price">{{ section.settings.price_2 | default: "$XXX" }}</div>
            <ul class="emg-list">
              <li>Complete Emergenetics assessment</li>
              <li>Self-paced eLearning modules</li>
              <li>Live debrief with application guidance</li>
            </ul>
            {% if section.settings.buy_url_2 != blank %}
              <a class="emg-btn emg-btn-primary emg-full" href="{{ section.settings.buy_url_2 }}" aria-label="Enroll in Assessment with eLearning package">
                Enroll Now
              </a>
            {% endif %}
          </div>
        </article>

        <!-- Card 3 -->
        <article class="emg-card">
          {% if section.settings.card3_image %}
            <img class="emg-card-img" src="{{ section.settings.card3_image | image_url: width: 900 }}" alt="Team Bundle with workshop" loading="lazy">
          {% endif %}
          <div class="emg-card-pad">
            <h3 class="emg-card-title">Team Bundle (5) + Workshop</h3>
            <p class="emg-card-desc">Perfect for small teams ready to level up</p>
            <div class="emg-price">{{ section.settings.price_3 | default: "$XXX" }}</div>
            <ul class="emg-list">
              <li>5 individual assessments included</li>
              <li>Team profile insights and analysis</li>
              <li>90–120 minute virtual workshop</li>
            </ul>
            {% if section.settings.buy_url_3 != blank %}
              <a class="emg-btn emg-btn-primary emg-full" href="{{ section.settings.buy_url_3 }}" aria-label="Build your team experience with Emergenetics">
                Build Your Team Experience
              </a>
            {% endif %}
          </div>
        </article>
      </div>
    </div>
  </div>

  <!-- How it works -->
  <div class="emg-section emg-card-bg" aria-labelledby="how-{{ section.id }}">
    <div class="emg-container">
      <h2 id="how-{{ section.id }}" class="emg-h2 emg-center">How It Works</h2>
      <div class="emg-grid3 emg-steps">
        <div class="emg-step">
          <div class="emg-step-num">1</div>
          <h3 class="emg-h3">Purchase</h3>
          <p>Select your package and receive your personalized assessment link.</p>
        </div>
        <div class="emg-step">
          <div class="emg-step-num">2</div>
          <h3 class="emg-h3">Complete</h3>
          <p>Take the assessment (approximately 20 minutes).</p>
        </div>
        <div class="emg-step">
          <div class="emg-step-num">3</div>
          <h3 class="emg-h3">Apply</h3>
          <p>Join your debrief or workshop and gain actionable insights.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Testimonials -->
  <div class="emg-section emg-muted-bg" aria-labelledby="testimonials-{{ section.id }}">
    <div class="emg-container">
      <h2 id="testimonials-{{ section.id }}" class="emg-h2 emg-center">What People Say</h2>
      <div class="emg-grid3">
        <blockquote class="emg-test">
          <p>"Our team finally speaks the same language. Understanding our thinking preferences transformed how we collaborate."</p>
          <footer>
            <div class="emg-name">{{ section.settings.t1_name | default: "[[name 1]]" }}</div>
            <div class="emg-title">{{ section.settings.t1_title | default: "Testimonial 1 title" }}</div>
          </footer>
        </blockquote>
        <blockquote class="emg-test">
          <p>"The insights from my debrief with Jes were game-changing. I now understand why I approach problems the way I do."</p>
          <footer>
            <div class="emg-name">{{ section.settings.t2_name | default: "Testimonial 2 name" }}</div>
            <div class="emg-title">{{ section.settings.t2_title | default: "Testimonial 2 title" }}</div>
          </footer>
        </blockquote>
        <blockquote class="emg-test">
          <p>"Emergenetics gave us a shared framework that made all the difference in our team's performance and morale."</p>
          <footer>
            <div class="emg-name">{{ section.settings.t3_name | default: "Testimonial 3 name" }}</div>
            <div class="emg-title">{{ section.settings.t3_title | default: "Testimonial 3 title" }}</div>
          </footer>
        </blockquote>
      </div>

      <!-- Logos -->
      <div class="emg-center emg-trusted">
        <p class="emg-muted">Trusted by leading organizations</p>
        <div class="emg-logos">
          {% for logo in (1..4) %}
            {% assign key = 'logo_' | append: logo %}
            {% if section.settings[key] %}
              <img src="{{ section.settings[key] | image_url: width: 260 }}" alt="Client logo {{ logo }}" loading="lazy">
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <!-- FAQ -->
  <div class="emg-section emg-card-bg" aria-labelledby="faq-{{ section.id }}">
    <div class="emg-container">
      <h2 id="faq-{{ section.id }}" class="emg-h2 emg-center">Frequently Asked Questions</h2>
      <div class="emg-faq">
        <details>
          <summary>How long does the assessment take?</summary>
          <div class="emg-faq-a">About 20 minutes. It’s designed to be completed in one sitting.</div>
        </details>
        <details>
          <summary>What’s included in the debrief?</summary>
          <div class="emg-faq-a">A review of your cognitive and behavioral profile, practical insights, and an action plan (60–75 minutes).</div>
        </details>
        <details>
          <summary>Is this right for teams?</summary>
          <div class="emg-faq-a">Yes—our Team Bundle includes individual assessments, a team profile analysis, and a workshop to boost collaboration.</div>
        </details>
        <details>
          <summary>How do we schedule the workshop?</summary>
          <div class="emg-faq-a">After purchase you’ll receive a scheduling link to book a 90–120 minute virtual session.</div>
        </details>
        <details>
          <summary>Do you offer enterprise packages?</summary>
          <div class="emg-faq-a">Yes—use the contact form below and we’ll tailor a solution for your organization.</div>
        </details>
      </div>
    </div>
  </div>

  <!-- Contact -->
  <div id="contact-{{ section.id }}" class="emg-section emg-secondary" aria-labelledby="contact-heading-{{ section.id }}">
    <div class="emg-container">
      <div class="emg-center">
        <h2 id="contact-heading-{{ section.id }}" class="emg-h2 emg-light">Ready to Align How You Think and How You Work?</h2>
        <p class="emg-sub emg-light">Start your journey to better self-awareness and team collaboration today.</p>
        {% if section.settings.buy_url_1 != blank %}
          <a class="emg-btn emg-btn-primary" href="{{ section.settings.buy_url_1 }}">Start Your Assessment</a>
        {% endif %}
        <a class="emg-btn emg-btn-outline-light" href="#contact-form-{{ section.id }}">Talk to Jes</a>
      </div>

      <div id="contact-form-{{ section.id }}" class="emg-contact">
        <h3 class="emg-h3 emg-light emg-center">Get in Touch</h3>
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <p class="emg-success" role="status">Thanks! Your message has been sent.</p>
          {% endif %}
          {% if form.errors %}
            <div class="emg-error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <label for="ContactFormName-{{ section.id }}">Your Name</label>
          <input id="ContactFormName-{{ section.id }}" type="text" name="contact[name]" required>

          <label for="ContactFormEmail-{{ section.id }}">Email Address</label>
          <input id="ContactFormEmail-{{ section.id }}" type="email" name="contact[email]" required>

          <label for="ContactFormMessage-{{ section.id }}">Message</label>
          <textarea id="ContactFormMessage-{{ section.id }}" name="contact[body]" rows="5" required></textarea>

          <button type="submit" class="emg-btn emg-btn-primary emg-full">Send Message</button>
        {% endform %}
      </div>
    </div>
  </div>

  <!-- Mobile Sticky CTA -->
  {% if section.settings.show_mobile_cta %}
    <div class="emg-sticky-cta">
      {% if section.settings.buy_url_1 != blank %}
        <a class="emg-btn emg-btn-primary emg-full" href="{{ section.settings.buy_url_1 }}" aria-label="Start assessment - mobile CTA">
          {{ section.settings.mobile_cta_text | default: "Start Your Assessment" }}
        </a>
      {% endif %}
    </div>
  {% endif %}
</section>

<style>
  /* Scoped styles */
  #shopify-section-{{ section.id }} .emg-wrap { --primary: {{ section.settings.primary_color }}; --secondary: {{ section.settings.secondary_color }}; --bg: #0f0f0f; --cream: #f9f9f9; --text: #2a2a2a; --muted: #6b6b6b; --card: #ffffff; }
  #shopify-section-{{ section.id }} .emg-container { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  #shopify-section-{{ section.id }} .emg-center { text-align:center; }
  #shopify-section-{{ section.id }} .emg-hero { min-height: 80vh; display:flex; align-items:center; justify-content:center; background-size:cover; background-position:center; padding: 80px 0; }
  #shopify-section-{{ section.id }} .emg-hero-title { font-size: clamp(40px, 7vw, 88px); color: #fff; margin: 0 0 12px; letter-spacing:.02em; }
  #shopify-section-{{ section.id }} .emg-hero-subtitle { font-size: clamp(18px, 2.5vw, 24px); color: rgba(255,255,255,.9); max-width: 800px; margin: 0 auto 28px; }
  #shopify-section-{{ section.id }} .emg-cta-row { display:flex; gap:12px; flex-wrap:wrap; justify-content:center; }
  #shopify-section-{{ section.id }} .emg-btn { display:inline-block; padding: 14px 22px; border-radius: 8px; font-weight:600; text-decoration:none; transition: transform .15s ease, background .15s ease, color .15s ease; }
  #shopify-section-{{ section.id }} .emg-btn-primary { background: var(--primary); color:#fff; }
  #shopify-section-{{ section.id }} .emg-btn-primary:hover { transform: translateY(-2px); }
  #shopify-section-{{ section.id }} .emg-btn-outline { border:2px solid #fff; color:#fff; }
  #shopify-section-{{ section.id }} .emg-btn-outline:hover { background:#fff; color: var(--secondary); }
  #shopify-section-{{ section.id }} .emg-btn-outline-light { border:2px solid #fff; color:#fff; }
  #shopify-section-{{ section.id }} .emg-btn-outline-light:hover { background:#fff; color: var(--secondary); }
  #shopify-section-{{ section.id }} .emg-full { width:100%; text-align:center; }

  #shopify-section-{{ section.id }} .emg-section { padding: 64px 0; }
  #shopify-section-{{ section.id }} .emg-muted-bg { background: #f7f7f7; }
  #shopify-section-{{ section.id }} .emg-card-bg { background: #ffffff; }
  #shopify-section-{{ section.id }} .emg-secondary { background: var(--secondary); color:#fff; }

  #shopify-section-{{ section.id }} .emg-h2 { font-size: clamp(32px, 4.5vw, 56px); color: var(--secondary); margin: 0 0 28px; }
  #shopify-section-{{ section.id }} .emg-h3 { font-size: 22px; color: var(--secondary); margin: 8px 0 6px; }
  #shopify-section-{{ section.id }} .emg-sub { font-size: 18px; color: rgba(255,255,255,.9); margin-bottom: 24px; }

  #shopify-section-{{ section.id }} .emg-two { display:grid; grid-template-columns: 1fr; gap: 18px; max-width: 820px; margin: 0 auto 12px; }
  @media (min-width: 800px){ #shopify-section-{{ section.id }} .emg-two { grid-template-columns: 1fr 1fr; } }
  #shopify-section-{{ section.id }} .emg-item { padding: 16px; display:flex; flex-direction:column; align-items:center; }
  #shopify-section-{{ section.id }} .emg-icon { font-size: 44px; color: var(--primary); margin-bottom: 8px; }
  #shopify-section-{{ section.id }} .emg-muted { color: #666; }

  #shopify-section-{{ section.id }} .emg-grid3 { display:grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 900px){ #shopify-section-{{ section.id }} .emg-grid3 { grid-template-columns: repeat(3, 1fr); } }

  #shopify-section-{{ section.id }} .emg-card { border: 2px solid rgba(0,0,0,.08); border-radius: 12px; overflow:hidden; background:#fff; position:relative; box-shadow: 0 8px 26px rgba(0,0,0,.06); }
  #shopify-section-{{ section.id }} .emg-card-highlight { border-color: rgba(0,0,0,.15); }
  #shopify-section-{{ section.id }} .emg-badge { position:absolute; top:12px; right:12px; background: var(--primary); color:#fff; padding: 6px 10px; border-radius: 999px; font-size: 12px; font-weight:700; }
  #shopify-section-{{ section.id }} .emg-card-img { width:100%; height: 200px; object-fit: cover; display:block; }
  #shopify-section-{{ section.id }} .emg-card-pad { padding: 16px; }
  #shopify-section-{{ section.id }} .emg-card-title { font-size: 24px; color: var(--secondary); margin: 0 0 4px; }
  #shopify-section-{{ section.id }} .emg-card-desc { color: #666; margin: 0 0 10px; }
  #shopify-section-{{ section.id }} .emg-price { font-size: 28px; font-weight:700; color: var(--primary); margin: 10px 0 12px; }
  #shopify-section-{{ section.id }} .emg-list { padding-left: 18px; margin: 0 0 16px; }

  #shopify-section-{{ section.id }} .emg-steps .emg-step { text-align:center; }
  #shopify-section-{{ section.id }} .emg-step-num { width: 72px; height:72px; margin: 0 auto 10px; border-radius: 999px; background: rgba(0,0,0,.06); display:flex; align-items:center; justify-content:center; font-size: 28px; color: var(--primary); font-weight:700; }

  #shopify-section-{{ section.id }} .emg-test { background:#fff; border:1px solid rgba(0,0,0,.08); border-radius: 10px; padding: 16px; }
  #shopify-section-{{ section.id }} .emg-test p { color:#333; font-style: italic; margin: 0 0 12px; }
  #shopify-section-{{ section.id }} .emg-name { font-weight:700; color: var(--secondary); }
  #shopify-section-{{ section.id }} .emg-title { font-size: 13px; color:#777; }

  #shopify-section-{{ section.id }} .emg-trusted { margin-top: 28px; text-align:center; }
  #shopify-section-{{ section.id }} .emg-logos { display:flex; flex-wrap:wrap; gap: 20px; justify-content:center; opacity:.7; filter: grayscale(100%); }

  #shopify-section-{{ section.id }} .emg-faq details { border:1px solid rgba(0,0,0,.1); border-radius: 10px; padding: 12px 14px; background:#fff; }
  #shopify-section-{{ section.id }} .emg-faq details summary { cursor:pointer; font-weight:700; color: var(--secondary); }
  #shopify-section-{{ section.id }} .emg-faq details .emg-faq-a { color:#444; margin-top: 8px; }

  #shopify-section-{{ section.id }} .emg-contact { background: rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.25); border-radius: 12px; padding: 16px; margin-top: 24px; backdrop-filter: blur(6px); }
  #shopify-section-{{ section.id }} .emg-contact label { display:block; margin: 10px 0 6px; color: #fff; font-weight:600; }
  #shopify-section-{{ section.id }} .emg-contact input, 
  #shopify-section-{{ section.id }} .emg-contact textarea { width:100%; border:1px solid rgba(255,255,255,.3); background: rgba(255,255,255,.15); color:#fff; padding: 10px 12px; border-radius: 8px; }
  #shopify-section-{{ section.id }} .emg-success { background: #1f9d55; color:#fff; padding:10px; border-radius:8px; }
  #shopify-section-{{ section.id }} .emg-error { background: #b91c1c; color:#fff; padding:10px; border-radius:8px; }

  /* Sticky CTA (mobile) */
  #shopify-section-{{ section.id }} .emg-sticky-cta { position: fixed; left:0; right:0; bottom:0; padding: 12px; background: var(--secondary); box-shadow: 0 -8px 24px rgba(0,0,0,.18); z-index: 50; }
  @media (min-width: 768px){ #shopify-section-{{ section.id }} .emg-sticky-cta { display:none; } }
</style>

{% schema %}
{
  "name": "Emergenetics Page",
  "class": "emergenetics-landing",
  "settings": [
    { "type": "color", "id": "primary_color", "label": "Primary color", "default": "#C8A046" },
    { "type": "color", "id": "secondary_color", "label": "Secondary color", "default": "#2B2B2B" },

    { "type": "image_picker", "id": "hero_image", "label": "Hero background image" },
    { "type": "text", "id": "hero_title", "label": "Hero title", "default": "Unlock the Science of You" },
    { "type": "text", "id": "hero_subtitle", "label": "Hero subtitle", "default": "Discover how you think, behave, and collaborate with Emergenetics®" },
    { "type": "text", "id": "cta_primary_text", "label": "Primary CTA text", "default": "Start Your Assessment" },
    { "type": "text", "id": "cta_secondary_text", "label": "Secondary CTA text", "default": "Talk to Jes" },

    { "type": "image_picker", "id": "card1_image", "label": "Card 1 image" },
    { "type": "text", "id": "price_1", "label": "Price (Card 1)", "default": "$XXX" },
    { "type": "url", "id": "buy_url_1", "label": "Buy URL (Card 1)" },

    { "type": "image_picker", "id": "card2_image", "label": "Card 2 image" },
    { "type": "text", "id": "price_2", "label": "Price (Card 2)", "default": "$XXX" },
    { "type": "url", "id": "buy_url_2", "label": "Buy URL (Card 2)" },

    { "type": "image_picker", "id": "card3_image", "label": "Card 3 image" },
    { "type": "text", "id": "price_3", "label": "Price (Card 3)", "default": "$XXX" },
    { "type": "url", "id": "buy_url_3", "label": "Buy URL (Card 3)" },

    { "type": "text", "id": "t1_name", "label": "Testimonial 1 name" },
    { "type": "text", "id": "t1_title", "label": "Testimonial 1 title" },
    { "type": "text", "id": "t2_name", "label": "Testimonial 2 name" },
    { "type": "text", "id": "t2_title", "label": "Testimonial 2 title" },
    { "type": "text", "id": "t3_name", "label": "Testimonial 3 name" },
    { "type": "text", "id": "t3_title", "label": "Testimonial 3 title" },

    { "type": "image_picker", "id": "logo_1", "label": "Logo 1" },
    { "type": "image_picker", "id": "logo_2", "label": "Logo 2" },
    { "type": "image_picker", "id": "logo_3", "label": "Logo 3" },
    { "type": "image_picker", "id": "logo_4", "label": "Logo 4" },

    { "type": "checkbox", "id": "show_mobile_cta", "label": "Show mobile sticky CTA", "default": true },
    { "type": "text", "id": "mobile_cta_text", "label": "Mobile CTA text", "default": "Start Your Assessment" }
  ],
  "presets": [
    { "name": "Emergenetics Page" }
  ]
}
{% endschema %}
