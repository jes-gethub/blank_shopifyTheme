{%- comment -%}
  Image with Text Section
  A two-column section with image and text content, supporting flexible layout options and an optional button.
{%- endcomment -%}

{%- style -%}
  .image-with-text-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: {{ section.settings.background_color }};
  }

  @media screen and (min-width: 750px) {
    .image-with-text-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: 40px;
      padding-right: 40px;
    }
  }

  .image-with-text-{{ section.id }} .image-with-text__container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .image-with-text-{{ section.id }} .image-with-text__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: {{ section.settings.vertical_alignment }};
  }

  @media screen and (min-width: 750px) {
    .image-with-text-{{ section.id }} .image-with-text__grid {
      grid-template-columns: 1fr 1fr;
      gap: {{ section.settings.column_gap }}px;
    }

    .image-with-text-{{ section.id }} .image-with-text__grid--image-right .image-with-text__media {
      order: 2;
    }

    .image-with-text-{{ section.id }} .image-with-text__grid--image-right .image-with-text__content {
      order: 1;
    }
  }

  .image-with-text-{{ section.id }} .image-with-text__media {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  .image-with-text-{{ section.id }} .image-with-text__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .image-with-text-{{ section.id }} .image-with-text__placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-with-text-{{ section.id }} .image-with-text__placeholder svg {
    width: 60px;
    height: 60px;
    opacity: 0.4;
  }

  .image-with-text-{{ section.id }} .image-with-text__content {
    text-align: {{ section.settings.text_alignment }};
  }

  .image-with-text-{{ section.id }} .image-with-text__heading {
    margin: 0 0 16px 0;
    font-size: clamp(24px, 4vw, 36px);
    line-height: 1.2;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
  }

  .image-with-text-{{ section.id }} .image-with-text__text {
    margin: 0 0 24px 0;
    font-size: clamp(16px, 2vw, 18px);
    line-height: 1.6;
    color: {{ section.settings.text_color }};
  }

  .image-with-text-{{ section.id }} .image-with-text__text p {
    margin: 0 0 1em 0;
  }

  .image-with-text-{{ section.id }} .image-with-text__text p:last-child {
    margin-bottom: 0;
  }

  .image-with-text-{{ section.id }} .image-with-text__button {
    display: inline-block;
    padding: 14px 28px;
    background-color: {{ section.settings.button_background_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    border-radius: {{ section.settings.button_border_radius }}px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .image-with-text-{{ section.id }} .image-with-text__button:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .image-with-text-{{ section.id }} .image-with-text__button:focus {
    outline: 2px solid {{ section.settings.button_background_color }};
    outline-offset: 2px;
  }
{%- endstyle -%}

<section 
  class="image-with-text-{{ section.id }}"
  aria-labelledby="image-with-text-heading-{{ section.id }}"
>
  <div class="image-with-text__container">
    <div class="image-with-text__grid{% if section.settings.layout == 'image_right' %} image-with-text__grid--image-right{% endif %}">
      {%- comment -%} Image Column {%- endcomment -%}
      <div class="image-with-text__media">
        {%- if section.settings.image != blank -%}
          {%- liquid
            assign image_alt = section.settings.image.alt | default: section.settings.heading | escape
            assign image_widths = '375, 550, 750, 1000, 1250, 1500'
          -%}
          
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              alt: image_alt,
              class: 'image-with-text__image',
              widths: image_widths,
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: 'lazy'
          }}
        {%- else -%}
          <div class="image-with-text__placeholder" role="img" aria-label="Placeholder image">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Content Column {%- endcomment -%}
      <div class="image-with-text__content">
        {%- if section.settings.heading != blank -%}
          <h2 id="image-with-text-heading-{{ section.id }}" class="image-with-text__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="image-with-text__text rte">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
          <a 
            href="{{ section.settings.button_link }}" 
            class="image-with-text__button"
            aria-label="{{ section.settings.button_text | escape }}"
          >
            {{ section.settings.button_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with Text",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image with Text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Use this section to pair an image with text. Add details about your products, collections, or brand.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position (desktop)",
      "options": [
        {
          "value": "image_left",
          "label": "Image left"
        },
        {
          "value": "image_right",
          "label": "Image right"
        }
      ],
      "default": "image_left"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Column gap (desktop)",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 4
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Image with Text"
    }
  ]
}
{% endschema %}
