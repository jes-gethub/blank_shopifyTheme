{%- comment -%}
  Image Section
  A flexible image section with image picker, alt text, sizing, alignment, optional link, and padding controls.
{%- endcomment -%}

{%- style -%}
  .image-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: {{ section.settings.background_color }};
  }

  @media screen and (min-width: 750px) {
    .image-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: 40px;
      padding-right: 40px;
    }
  }

  .image-section-{{ section.id }} .image-section__container {
    max-width: 1400px;
    margin: 0 auto;
    text-align: {{ section.settings.image_alignment }};
  }

  .image-section-{{ section.id }} .image-section__media {
    display: inline-block;
    width: 100%;
    max-width: {{ section.settings.image_width }}px;
    position: relative;
  }

  .image-section-{{ section.id }} .image-section__link {
    display: block;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .image-section-{{ section.id }} .image-section__link:hover {
    opacity: 0.9;
  }

  .image-section-{{ section.id }} .image-section__image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ section.settings.border_radius }}px;
  }

  .image-section-{{ section.id }} .image-section__placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ section.settings.border_radius }}px;
  }

  .image-section-{{ section.id }} .image-section__placeholder svg {
    width: 60px;
    height: 60px;
    opacity: 0.4;
  }

  .image-section-{{ section.id }} .image-section__caption {
    margin-top: 12px;
    font-size: 14px;
    color: {{ section.settings.caption_color }};
  }
{%- endstyle -%}

<section 
  class="image-section-{{ section.id }}"
  aria-label="{{ section.settings.image_alt | default: 'Image section' | escape }}"
>
  <div class="image-section__container">
    <figure class="image-section__media">
      {%- if section.settings.image != blank -%}
        {%- liquid
          assign image_alt = section.settings.image_alt | default: section.settings.image.alt | escape
          assign image_widths = '375, 550, 750, 1000, 1250, 1500, 1750, 2000'
        -%}
        
        {%- if section.settings.link_url != blank -%}
          <a 
            href="{{ section.settings.link_url }}" 
            class="image-section__link"
            aria-label="{{ image_alt }}"
          >
        {%- endif -%}
        
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
            alt: image_alt,
            class: 'image-section__image',
            widths: image_widths,
            sizes: '(min-width: 750px) min(' | append: section.settings.image_width | append: 'px, 100vw), 100vw',
            loading: 'lazy'
        }}
        
        {%- if section.settings.link_url != blank -%}
          </a>
        {%- endif -%}
      {%- else -%}
        <div class="image-section__placeholder" role="img" aria-label="Placeholder image">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
        </div>
      {%- endif -%}
      
      {%- if section.settings.caption != blank -%}
        <figcaption class="image-section__caption">
          {{ section.settings.caption | escape }}
        </figcaption>
      {%- endif -%}
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "Image Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Describe the image for accessibility. If left blank, the image's alt text will be used."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image caption"
    },
    {
      "type": "header",
      "content": "Size & Layout"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 200,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Image max width",
      "default": 800
    },
    {
      "type": "select",
      "id": "image_alignment",
      "label": "Image alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Caption color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Image Section"
    }
  ]
}
{% endschema %}
